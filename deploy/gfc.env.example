# GFC node configuration (/etc/gfc/gfc.env, readable by root and the gfc user only).
# After editing:  systemctl restart gfc-node

GFC_DATA_DIR=/var/lib/gfc

# --- Treasury (this node signs grants and rewards for the whole network) ---
GFC_TREASURY_KEY_FILE=/var/lib/gfc/treasury_key.hex
# Needed only if the key file is encrypted (python signing.py encrypt):
GFC_TREASURY_PASSPHRASE=

# --- Phone verification with Firebase phone sign-in (docs/moderation-and-web-verify.md). ---
# The web app's public config from the Firebase console, as one line of JSON in single quotes
# (systemd and bash would strip the double quotes otherwise). When set, the
# browser verification page texts codes through Firebase. Empty = phone verification is off.
# GFC_FIREBASE_CONFIG='{"apiKey":"...","authDomain":"<project>.firebaseapp.com","projectId":"<project>","appId":"..."}'
GFC_FIREBASE_CONFIG=

# Secret for hashing phone numbers. Back it up: losing it lets numbers be reused.
GFC_PHONE_HMAC_KEY_FILE=/var/lib/gfc/phone_hmac_key.hex

# --- Moderation (see moderation.py): different accounts' reports that hide a post until reviewed ---
GFC_REPORT_HIDE_THRESHOLD=3

# --- Public share pages (used once the share-pages PR is merged) ---
GFC_PUBLIC_BASE_URL=https://__DOMAIN__

# --- Analytics: Microsoft Clarity project ID for the web feed and share pages only ---
# (from the project's URL at clarity.microsoft.com). Empty = no analytics.
GFC_CLARITY_PROJECT_ID=

# --- Echo Hunt (3D-audio anti-bot game for the Android app; see docs/echo-hunt.md) ---
# 1 = a viewer's rewarded play needs an Echo Hunt pass from the last 24h.
# Leave 0 until the Android app with Echo Hunt is released, or plays stop paying.
GFC_REQUIRE_ECHOHUNT=0
# Google Play Integrity: service-account JSON key (linked to the app in Play Console)
# and the app's package name. Both set = a passing integrity verdict is required for
# an Echo Hunt pass. Empty = the integrity check is skipped.
GFC_PLAY_INTEGRITY_SA_FILE=
GFC_ANDROID_PACKAGE=
# SHA-256 fingerprints of the app's signing certificates (comma-separated), for App Links
# (/.well-known/assetlinks.json): GFC links open the app. Scripts/CreateReleaseKey.ps1 prints it.
# Also required by `gfc publish-app`: only APKs signed with one of these can be published at /app.
GFC_ANDROID_CERT_SHA256=

# --- Bridge to Base (see docs/bridge-service.md). Leave empty until the bridge launches. ---
# Escrow pins are consensus config: normally set in config.PINNED_BRIDGE_ESCROWS by a release.
# This override is for test networks only: "84532:<escrow pubkey>"
GFC_BRIDGE_ESCROWS=
# Token contract shown in /bridge/info, once it's deployed and verified: "84532:0x..."
GFC_BRIDGE_TOKENS=
# Must match the bridge service's settings (in cents / days)
GFC_BRIDGE_MIN_DEPOSIT_CENTS=10000
GFC_BRIDGE_RELAY_FEE_CENTS=0
GFC_BRIDGE_FAUCET_HOLD_DAYS=14
