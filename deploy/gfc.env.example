# GFC node configuration (/etc/gfc/gfc.env, readable by root and the gfc user only).
# After editing:  systemctl restart gfc-node

GFC_DATA_DIR=/var/lib/gfc

# --- Treasury (this node signs grants and rewards for the whole network) ---
GFC_TREASURY_KEY_FILE=/var/lib/gfc/treasury_key.hex
# Needed only if the key file is encrypted (python signing.py encrypt):
GFC_TREASURY_PASSPHRASE=

# --- Phone verification (Twilio Verify). Leave empty to use the built-in fake provider (dev only). ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# 1 = refuse VoIP/virtual numbers via Twilio Lookup (small extra cost per check)
TWILIO_LOOKUP_LINE_TYPE=1
# Secret for hashing phone numbers. Back it up: losing it lets numbers be reused.
GFC_PHONE_HMAC_KEY_FILE=/var/lib/gfc/phone_hmac_key.hex

# --- Cloudflare Turnstile (bot check before an SMS is sent). Empty = check skipped. ---
GFC_TURNSTILE_SECRET=

# --- Public share pages (used once the share-pages PR is merged) ---
GFC_PUBLIC_BASE_URL=https://__DOMAIN__
