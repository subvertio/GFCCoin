#!/usr/bin/env bash
# gfc - one command for running the GFC node.  Run as root on the server, or
# from Windows:  ssh gfc-node gfc check   (add -t for commands that prompt)
set -euo pipefail

# Paths can be overridden (GFC_*) to test the helper against a scratch setup
APP_DIR="${GFC_APP_DIR:-/opt/gfc/app}"
VENV="${GFC_VENV:-/opt/gfc/venv}"
ENV_FILE="${GFC_ENV_FILE:-/etc/gfc/gfc.env}"
DATA_DIR="${GFC_DATA_ROOT:-/var/lib/gfc}"
BACKUP_DIR="${GFC_BACKUP_DIR:-/var/backups/gfc}"

usage() {
    cat <<'EOF'
usage: gfc <command>

  check                 plain-English status of the node
  logs [N]              last N lines of the node log (default 50)
  restart               restart the node
  config                edit secrets/settings, then restart
  update                back up, pull the latest code, restart
  backup                back up now
  restore-treasury [F]  restore the treasury key from an encrypted backup
                        (default F: /var/lib/gfc/treasury.backup; needs ssh -t)
  encrypt-treasury      encrypt the treasury key file with the passphrase saved
                        in the settings (set GFC_TREASURY_PASSPHRASE via gfc config first)
  rotate-treasury       step 1 of replacing the treasury key: create the new key
                        (encrypted with the saved passphrase) and print its public
                        key to pin in config.py
  rotate-treasury --activate
                        step 2, after the pin is merged and 'gfc update' has run:
                        switch the node to the new key (rolls back on failure)
EOF
}

die() { echo "error: $*" >&2; exit 1; }
need_root() { [[ $EUID -eq 0 ]] || die "run as root"; }

# Run a command as the gfc user with the node's settings loaded
as_gfc() {
    runuser -u gfc -- env GFC_APP_DIR="$APP_DIR" \
        bash -c 'set -a; . "$0"; set +a; cd "$GFC_APP_DIR"; exec "$@"' "$ENV_FILE" "$@"
}

# Wait (up to 60s) for the node to answer after a restart, so checks don't race it
wait_for_node() {
    local i
    for i in $(seq 1 60); do
        curl -fsS --max-time 2 http://127.0.0.1:8000/health >/dev/null 2>&1 && return 0
        sleep 1
    done
    echo "warning: node still not answering after 60s (gfc logs)" >&2
    return 1
}

restart_node() {
    systemctl restart gfc-node
    echo -n "restarting node... "
    if wait_for_node; then echo "up"; fi
}

env_value() {
    # Value of KEY in the env file ('' if unset), without sourcing it into this shell
    sed -n "s/^$1=//p" "$ENV_FILE" | tail -n 1
}

treasury_loaded() {
    as_gfc "$VENV/bin/python" -c 'import signing, sys; sys.exit(0 if signing.load_treasury_private_key() else 1)' 2>/dev/null
}

line() { printf '  %-5s %s\n' "$1" "$2"; }

cmd_check() {
    need_root
    echo "GFC node status"
    if systemctl is-active -q gfc-node; then line ok "node service running"; else line FAIL "node service not running (try: gfc logs)"; fi
    if curl -fsS --max-time 5 http://127.0.0.1:8000/health >/dev/null 2>&1; then line ok "API answering locally"; else line FAIL "API not answering on 127.0.0.1:8000"; fi
    if systemctl is-active -q caddy; then line ok "web server (Caddy) running"; else line FAIL "Caddy not running (journalctl -u caddy)"; fi

    local base; base="$(env_value GFC_PUBLIC_BASE_URL)"
    if [[ -n "$base" ]]; then
        if curl -fsS --max-time 10 "$base/health" >/dev/null 2>&1; then line ok "HTTPS works: $base"
        else line FAIL "HTTPS not working at $base (DNS or certificate; journalctl -u caddy)"; fi
    fi

    local keyfile; keyfile="$(env_value GFC_TREASURY_KEY_FILE)"; keyfile="${keyfile:-$DATA_DIR/treasury_key.hex}"
    if [[ ! -f "$keyfile" ]]; then
        line --   "treasury key not installed (gfc restore-treasury)"
    elif treasury_loaded; then
        line ok   "treasury key loaded and pinned - this node signs grants and rewards"
    elif grep -q '^{' "$keyfile"; then
        line FAIL "treasury key is encrypted but GFC_TREASURY_PASSPHRASE is missing or wrong (gfc config)"
    else
        line FAIL "treasury key file present but not usable (is its public key pinned in config.py?)"
    fi

    if [[ -f "$DATA_DIR/treasury_key.next" ]]; then
        line info "new treasury key staged, not active yet: $(next_pubkey 2>/dev/null || echo '?') (gfc rotate-treasury --activate)"
    fi

    if [[ -n "$(env_value TWILIO_ACCOUNT_SID)"&& -n "$(env_value TWILIO_AUTH_TOKEN)" && -n "$(env_value TWILIO_VERIFY_SERVICE_SID)" ]]; then
        line ok "Twilio phone verification configured"
    else
        line --  "Twilio not configured - using the fake test provider (gfc config)"
    fi
    if [[ -n "$(env_value GFC_TURNSTILE_SECRET)" ]]; then line ok "Turnstile configured"; else line -- "Turnstile not configured - bot check skipped (gfc config)"; fi

    local last; last="$(ls -1t "$BACKUP_DIR"/gfc-*.tar.gz 2>/dev/null | head -n 1 || true)"
    if [[ -n "$last" ]]; then line ok "last backup: $(date -u -r "$last" '+%Y-%m-%d %H:%M UTC')"; else line --  "no backups yet (first runs 03:30 UTC, or: gfc backup)"; fi

    line info "code: $(git -C "$APP_DIR" log -1 --format='%h %s' 2>/dev/null)"
    line info "disk free: $(df -h --output=avail "$DATA_DIR" | tail -n 1 | tr -d ' ')"
}

cmd_restore_treasury() {
    need_root
    local src="${1:-$DATA_DIR/treasury.backup}"
    local keyfile; keyfile="$(env_value GFC_TREASURY_KEY_FILE)"; keyfile="${keyfile:-$DATA_DIR/treasury_key.hex}"
    [[ -f "$keyfile" ]] && die "a treasury key is already installed at $keyfile (nothing to do; 'gfc check' shows its status)"
    [[ -f "$src" ]] || die "no backup at $src. Upload it first:  scp F:\\GFC\\treasury.backup gfc-node:$DATA_DIR/treasury.backup"
    [[ -t 0 ]] || die "this asks for your backup passphrase: run it with  ssh -t gfc-node gfc restore-treasury"
    # Must be readable by the gfc user; copy rather than chown in case it lives elsewhere
    if [[ "$src" != "$DATA_DIR"/* ]]; then install -o gfc -g gfc -m 600 "$src" "$DATA_DIR/treasury.backup"; src="$DATA_DIR/treasury.backup"; fi
    chown gfc:gfc "$src"
    as_gfc "$VENV/bin/python" signing.py restore "$src"
    rm -f "$src"
    restart_node
    if treasury_loaded; then echo "Treasury key restored and loaded. The uploaded backup copy was deleted from the server."
    else echo "Key restored, but the node can't use it yet - run: gfc check" >&2; fi
}

cmd_encrypt_treasury() {
    # Uses the passphrase already saved in the settings, so there is nothing to
    # mistype, and rolls back if the node can't unlock the result.
    need_root
    local keyfile; keyfile="$(env_value GFC_TREASURY_KEY_FILE)"; keyfile="${keyfile:-$DATA_DIR/treasury_key.hex}"
    [[ -f "$keyfile" ]] || die "no treasury key installed (gfc restore-treasury first)"
    grep -q '^{' "$keyfile" && die "the treasury key is already encrypted ('gfc check' shows whether it unlocks)"
    [[ -n "$(env_value GFC_TREASURY_PASSPHRASE)" ]] || die "set the passphrase first: run  ssh -t gfc-node gfc config  and fill in GFC_TREASURY_PASSPHRASE= (12+ characters; keep a copy in your password manager)"
    as_gfc bash -c '[[ ${#GFC_TREASURY_PASSPHRASE} -ge 12 ]]' \
        || die "GFC_TREASURY_PASSPHRASE must be at least 12 characters (gfc config)"
    treasury_loaded || die "the node can't use the current key file, so it won't be encrypted (gfc check)"

    local safety="$keyfile.pre-encrypt"
    install -o gfc -g gfc -m 600 "$keyfile" "$safety"
    # Pass the saved passphrase to signing.py as the "typed" one (no prompt)
    if ! as_gfc bash -c 'GFC_BACKUP_PASSPHRASE="$GFC_TREASURY_PASSPHRASE" exec "$0" signing.py encrypt' "$VENV/bin/python" >/dev/null; then
        install -o gfc -g gfc -m 600 "$safety" "$keyfile"; rm -f "$safety"
        die "encryption failed; the key file is unchanged (is the passphrase at least 12 characters?)"
    fi
    if treasury_loaded; then
        rm -f "$safety"
        echo "Treasury key encrypted with the passphrase in the settings, and the node can unlock it."
    else
        install -o gfc -g gfc -m 600 "$safety" "$keyfile"; rm -f "$safety"
        die "the node couldn't unlock the encrypted key, so the change was rolled back (key file unchanged)"
    fi
}

next_pubkey() {
    as_gfc "$VENV/bin/python" signing.py pubkey "$DATA_DIR/treasury_key.next"
}

next_is_pinned() {
    as_gfc "$VENV/bin/python" -c 'import signing, sys; sys.exit(0 if sys.argv[1] in signing.treasury_pubkeys() else 1)' "$1"
}

cmd_rotate_treasury() {
    need_root
    local keyfile; keyfile="$(env_value GFC_TREASURY_KEY_FILE)"; keyfile="${keyfile:-$DATA_DIR/treasury_key.hex}"
    local next="$DATA_DIR/treasury_key.next"

    if [[ "${1:-}" != "--activate" ]]; then
        # Step 1: stage a new key, encrypted from the start with the saved passphrase
        if [[ -f "$next" ]]; then
            echo "A new treasury key is already staged. Its public key:"
            next_pubkey
            echo "Pin it in config.py, merge, run 'gfc update', then: gfc rotate-treasury --activate"
            return 0
        fi
        as_gfc bash -c '[[ ${#GFC_TREASURY_PASSPHRASE} -ge 12 ]]' \
            || die "set GFC_TREASURY_PASSPHRASE (12+ characters) first: ssh -t gfc-node gfc config"
        local pub
        pub="$(as_gfc bash -c 'GFC_BACKUP_PASSPHRASE="$GFC_TREASURY_PASSPHRASE" exec "$0" signing.py generate-encrypted "$1"' \
               "$VENV/bin/python" "$next")" || die "could not create the new key"
        echo "New treasury key staged (encrypted with the passphrase in the settings)."
        echo "Public key to pin in config.py PINNED_TREASURY_PUBKEYS:"
        echo "  $pub"
        echo "Offline copy: $next is itself an encrypted backup (restore with the same passphrase)."
        echo "Next: pin it, merge, 'gfc update', then: gfc rotate-treasury --activate"
        return 0
    fi

    # Step 2: switch over, only if the new key is pinned by the code now running
    [[ -f "$next" ]] || die "no staged key; run 'gfc rotate-treasury' first"
    local pub; pub="$(next_pubkey)" || die "can't open the staged key with GFC_TREASURY_PASSPHRASE (gfc config)"
    next_is_pinned "$pub" || die "the staged key $pub is not pinned by the running code yet: pin it in config.py, merge, run 'gfc update', then retry"

    local retired=""
    if [[ -f "$keyfile" ]]; then
        retired="$keyfile.retired-$(date -u +%Y%m%d-%H%M%S)"
        mv "$keyfile" "$retired"
    fi
    mv "$next" "$keyfile"
    chown gfc:gfc "$keyfile"; chmod 600 "$keyfile"
    restart_node
    if treasury_loaded; then
        echo "Treasury switched to $pub. The node signs with the new key."
        [[ -n "$retired" ]] && echo "Old key kept at $retired - delete it once you're happy:  rm $retired"
    else
        mv "$keyfile" "$next"
        [[ -n "$retired" ]] && mv "$retired" "$keyfile"
        restart_node
        die "the node couldn't load the new key, so the old one was put back (gfc check)"
    fi
}

cmd_config() {
    need_root
    [[ -t 0 ]] || die "this opens an editor: run it with  ssh -t gfc-node gfc config"
    "${EDITOR:-nano}" "$ENV_FILE"
    restart_node
    echo "Saved. Status:"
    cmd_check
}

case "${1:-}" in
    check)            cmd_check ;;
    logs)             journalctl -u gfc-node -n "${2:-50}" --no-pager ;;
    restart)          need_root; restart_node ;;
    config)           cmd_config ;;
    update)           need_root; /usr/local/sbin/gfc-update ;;
    backup)           need_root; /usr/local/sbin/gfc-backup ;;
    restore-treasury) shift; cmd_restore_treasury "$@" ;;
    encrypt-treasury) cmd_encrypt_treasury ;;
    rotate-treasury)  shift; cmd_rotate_treasury "$@" ;;
    ""|-h|--help|help) usage ;;
    *) usage; exit 2 ;;
esac
